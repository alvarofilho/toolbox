{
	"$schema": "./node_modules/@angular/cli/lib/config/schema.json",
	"version": 1,
	"cli": {
		"packageManager": "pnpm",
		"schematicCollections": ["angular-eslint"]
	},
	"newProjectRoot": "projects",
	"projects": {
		"toolbox": {
			"projectType": "application",
			"schematics": {
				"@schematics/angular:component": {
					"style": "scss"
				}
			},
			"root": "",
			"sourceRoot": "src",
			"prefix": "app",
			"architect": {
				"build": {
					"builder": "@angular/build:application",
					"options": {
						"allowedCommonJsDependencies": [
							"cron-parser",
							"cronstrue",
							"ipaddr.js",
							"jsbi",
							"jsonschema",
							"jszip",
							"nearley",
							"node-sql-parser/build/postgresql",
							"pako",
							"papaparse",
							"pvtsutils",
							"qrcode",
							"reflect-metadata",
							"semver",
							"shell-quote"
						],
						"outputPath": "dist/cloudflare",
						"deployUrl": "/",
						"browser": "src/main.ts",
						"tsConfig": "tsconfig.app.json",
						"webWorkerTsConfig": "tsconfig.worker.json",
						"inlineStyleLanguage": "scss",
						"assets": [
							{
								"glob": "**/*",
								"input": "public"
							}
						],
						"styles": [
							"src/tailwind.css",
							"src/styles.scss",
							"src/legibility.scss",
							"src/usability.scss"
						]
					},
					"configurations": {
						"production": {
							"optimization": {
								"scripts": true,
								"styles": {
									"minify": true,
									"inlineCritical": false
								},
								"fonts": false
							},
							"budgets": [
								{
									"type": "initial",
									"maximumWarning": "500kB",
									"maximumError": "1MB"
								},
								{
									"type": "anyComponentStyle",
									"maximumWarning": "4kB",
									"maximumError": "8kB"
								}
							],
							"outputHashing": "all"
						},
						"development": {
							"optimization": false,
							"extractLicenses": false,
							"sourceMap": true
						}
					},
					"defaultConfiguration": "production"
				},
				"serve": {
					"builder": "@angular/build:dev-server",
					"configurations": {
						"production": {
							"buildTarget": "toolbox:build:production"
						},
						"development": {
							"buildTarget": "toolbox:build:development"
						}
					},
					"defaultConfiguration": "development"
				},
				"test": {
					"builder": "@angular/build:unit-test"
				},
				"lint": {
					"builder": "@angular-eslint/builder:lint",
					"options": {
						"lintFilePatterns": ["src/**/*.ts", "src/**/*.html"]
					}
				}
			}
		}
	}
}
